[sub_resource type="GDScript" id="GDScript_ig7tw"]
script/source = "# This script sets up a simple tileset with one green tile and saves it to res://island_tileset.tres
# Attach this to a node in the scene and run the scene once to generate the tileset.
# Then remove this script.

extends Node

func _ready() -> void:
    # Create a green image (32x32)
    var img := Image.create(32, 32, false, Image.FORMAT_RGBA8)
    img.fill(Color(0.2, 0.8, 0.2, 1.0))  # green
    
    # Create ImageTexture from image
    var tex := ImageTexture.create_from_image(img)
    
    # Create TileSet
    var tileset := TileSet.new()
    
    # Create an atlas source
    var atlas_source := TileSetAtlasSource.new()
    atlas_source.set_texture(tex)
    # Set the texture region size to match the tile size (32x32)
    atlas_source.set_texture_region_size(Vector2i(32, 32))
    # Optional: set margins and separation to 0
    atlas_source.set_margins(Vector2i(0, 0))
    atlas_source.set_separation(Vector2i(0, 0))
    
    # Add the source to the tileset
    var source_id := tileset.add_source(atlas_source)
    
    # Create a tile at atlas coordinates (0,0) with size 32x32
    var source := tileset.get_source(source_id)
    if source:
        source.create_tile(Vector2i(0, 0), Vector2i(32, 32))
    else:
        push_error(\"Failed to get source from tileset\")
        return
    
    # Save the tileset to file
    var save_error := ResourceSaver.save(tileset, \"res://island_tileset.tres\")
    if save_error != OK:
        push_error(\"Failed to save tileset: %s\" % save_error)
    else:
        print(\"Tileset saved successfully.\")
    
    # We don't need this script anymore, but we'll remove it manually later.
    set_process(false)"

